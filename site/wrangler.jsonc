{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glitchbox",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The front end in public/ is served for free by Workers Static Assets.
  // Every /api, /play and /media request runs the Worker first.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/play/*", "/media/*", "/desktop/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "glitchbox", "database_id": "REPLACE_WITH_YOUR_D1_ID", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "glitchbox-files" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "CHAT", "class_name": "ChatHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatHub"] }],
  // Daily cleanup at 04:00 UTC (see cleanup() in src/index.js).
  "triggers": { "crons": ["0 4 * * *"] },
  "vars": {
    "SITE_NAME": "GlitchBox",
    "MAIL_FROM": "GlitchBox <login@blueprintgames.online>",
    "MAX_FILE_MB": "5000"
  },
  "observability": { "enabled": true }
}
